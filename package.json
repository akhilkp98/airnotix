    "simplebar": "5.3.9"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "autoprefixer": "10.5.4",
    "babel-loader": "9.2.1",
    "copy-webpack-plugin": "11.0.0",
    "cross-env": "7.0.3",
    "css-loader": "6.11.0",
    "css-minimizer-webpack-plugin": "5.0.1",
    "eslint": "8.57.1",
